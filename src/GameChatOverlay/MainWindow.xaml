<Window x:Class="GameChatOverlay.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Agripa" Icon="Assets/agripa.ico" Width="700" Height="760" MinWidth="400" MinHeight="520"
 AllowsTransparency="True" WindowStyle="None" ResizeMode="CanResize" Topmost="True" ShowInTaskbar="False"
 Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource InkBrush}"
 FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" PreviewKeyDown="Window_PreviewKeyDown">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0"/>
 </shell:WindowChrome.WindowChrome>
 <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18,14,18,12">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel MouseLeftButtonDown="Title_MouseLeftButtonDown" Background="Transparent" Margin="0,0,8,0">
     <StackPanel Orientation="Horizontal">
      <Image Source="Assets/agripa.ico" Width="24" Height="24" Margin="0,0,8,0"/>
      <TextBlock Text="Agripa" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </StackPanel>
     <TextBlock x:Name="HotkeyHint" Text="Ctrl+Alt+Espacio · mostrar / ocultar" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
    </StackPanel>
    <Button Grid.Column="1" x:Name="SettingsButton" ToolTip="Ajustes" AutomationProperties.Name="Ajustes" Click="Settings_Click" Margin="0,0,6,0" VerticalAlignment="Top" AutomationProperties.AutomationId="SettingsButton"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="16"/></Button>
    <Button Grid.Column="2" Content="—" Click="Hide_Click" VerticalAlignment="Top" Padding="10,8" ToolTip="Ocultar (Esc)" AutomationProperties.Name="Ocultar overlay" AutomationProperties.AutomationId="HideButton"/>
   </Grid>
   <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,12"/>
   <Grid Grid.Row="2" x:Name="BrowserPanel">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <WrapPanel Margin="0,0,0,8">
       <Button x:Name="CaptureButton" ToolTip="Capturar juego (Ctrl+Alt+C)" AutomationProperties.Name="Capturar juego" Click="Capture_Click" Margin="0,0,6,4" AutomationProperties.AutomationId="CaptureButton"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE722;" FontSize="16"/></Button>
       <Button x:Name="CropCaptureButton" ToolTip="Recortar captura" AutomationProperties.Name="Recortar captura" Click="CropCapture_Click" Margin="0,0,6,4" AutomationProperties.AutomationId="CropCaptureButton"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A8;" FontSize="16"/></Button>
       <Button ToolTip="Inicio" AutomationProperties.Name="Inicio" Click="BrowserHome_Click" Margin="0,0,6,4" AutomationProperties.AutomationId="BrowserHomeButton"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="16"/></Button>
       <Button x:Name="BrowserReloadButton" ToolTip="Recargar" AutomationProperties.Name="Recargar" Click="BrowserReload_Click" Margin="0,0,6,4" AutomationProperties.AutomationId="BrowserReloadButton"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="16"/></Button>
       <Button ToolTip="Abrir fuera" AutomationProperties.Name="Abrir fuera" Click="BrowserExternal_Click" Margin="0,0,0,4" AutomationProperties.AutomationId="BrowserExternalButton"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A7;" FontSize="16"/></Button>
      </WrapPanel>
      <TextBox Grid.Row="1" x:Name="BrowserAddressBox" IsReadOnly="True" Text="https://chatgpt.com/" FontSize="12" Padding="8,5" Margin="0,0,0,10"
       AutomationProperties.Name="Dirección de la página" AutomationProperties.AutomationId="BrowserAddressBox"/>
      <Grid Grid.Row="2">
       <Grid x:Name="BrowserHost"/>
       <StackPanel x:Name="BrowserNotice" VerticalAlignment="Center" Margin="16">
        <TextBlock x:Name="BrowserNoticeText" Text="Preparando el navegador…" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>
        <Button x:Name="InstallBrowserButton" Content="Descargar WebView2" Click="InstallBrowser_Click" HorizontalAlignment="Left" Visibility="Collapsed" AutomationProperties.AutomationId="InstallBrowserButton"/>
       </StackPanel>
      </Grid>
     </Grid>

   <ScrollViewer Grid.Row="2" x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock Text="Apariencia" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="Ajusta la opacidad del panel y de ChatGPT para ver el juego detrás. Los cambios se previsualizan al mover el control." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>
     <Label Content="Opacidad" Target="{Binding ElementName=OpacitySlider}" Foreground="{StaticResource InkBrush}" Padding="0,0,0,6"/>
     <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" Value="85" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10"
      ValueChanged="OpacitySlider_ValueChanged" AutomationProperties.Name="Opacidad del overlay" AutomationProperties.AutomationId="OpacitySlider"/>
     <TextBlock x:Name="OpacityValueText" Text="85 %" Margin="0,8,0,18" AutomationProperties.AutomationId="OpacityValueText"/>
     <WrapPanel>
      <Button Content="Guardar" Click="SaveSettings_Click" Background="{StaticResource AccentBrush}" Foreground="{StaticResource BackgroundBrush}" Margin="0,0,8,8" AutomationProperties.AutomationId="SaveSettingsButton"/>
      <Button Content="Volver al chat" Click="Back_Click" Margin="0,0,0,8" AutomationProperties.AutomationId="BackButton"/>
     </WrapPanel>
     <TextBlock Text="La opacidad se guarda para la próxima vez que abras la aplicación." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,16"/>
     <Button Content="Salir de la aplicación" Click="Exit_Click" HorizontalAlignment="Left" AutomationProperties.AutomationId="ExitButton"/>
    </StackPanel>
   </ScrollViewer>
   <TextBlock Grid.Row="3" x:Name="StatusText" Visibility="Collapsed" Text="Listo · Esc vuelve al juego" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,12,0,0"
    AutomationProperties.AutomationId="StatusText" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Grid.Row="3" x:Name="BrowserStatusText" Text="ChatGPT web · Esc vuelve al juego" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,12,0,0"
    AutomationProperties.AutomationId="BrowserStatusText" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
 </Border>
</Window>
