<Window x:Class="GameChatOverlay.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Overlay Chat" Width="440" Height="620" MinWidth="400" MinHeight="520"
 WindowStyle="None" ResizeMode="CanResize" Topmost="True" ShowInTaskbar="False"
 Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource InkBrush}"
 FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" PreviewKeyDown="Window_PreviewKeyDown">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0"/>
 </shell:WindowChrome.WindowChrome>
 <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18,14,18,12">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel MouseLeftButtonDown="Title_MouseLeftButtonDown" Background="Transparent" Margin="0,0,8,0">
     <TextBlock Text="Overlay Chat" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock x:Name="HotkeyHint" Text="Ctrl+Alt+Espacio · mostrar / ocultar" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
    </StackPanel>
    <Button Grid.Column="1" x:Name="SettingsButton" Content="Ajustes" Click="Settings_Click" Margin="0,0,6,0" VerticalAlignment="Top" AutomationProperties.AutomationId="SettingsButton"/>
    <Button Grid.Column="2" Content="—" Click="Hide_Click" VerticalAlignment="Top" Padding="10,8" ToolTip="Ocultar (Esc)" AutomationProperties.Name="Ocultar overlay" AutomationProperties.AutomationId="HideButton"/>
   </Grid>
   <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,12"/>
   <TabControl Grid.Row="2" x:Name="ChatTabs" AutomationProperties.AutomationId="ChatTabs">
    <TabItem x:Name="ApiTab" Header="Chat API" AutomationProperties.AutomationId="ApiTab">
   <Grid x:Name="ChatPanel">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
     <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="MessagesList" ItemsSource="{Binding Messages}">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <StackPanel Margin="0,4,0,18">
          <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,5"/>
          <TextBox Text="{Binding Body, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
           Background="Transparent" BorderThickness="0" Padding="0" IsReadOnlyCaretVisible="False"
           HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
           AutomationProperties.AutomationId="MessageBody">
           <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></DataTrigger></Style.Triggers>
           </Style></TextBox.Style>
          </TextBox>
         </StackPanel>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
     <ScrollViewer x:Name="EmptyState" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center">
     <StackPanel VerticalAlignment="Center" Margin="6,0,6,24">
      <TextBlock Text="Tu siguiente movimiento." FontSize="23" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock Text="Describe la situación y pregunta. El asistente solo conoce lo que escribes." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>
      <Button x:Name="ExampleButton" Click="Example_Click" HorizontalContentAlignment="Left" Padding="12" AutomationProperties.AutomationId="ExampleButton">
       <TextBlock Text="«Turno 12: tengo 3 tanques y 5 unidades de infantería cerca de Varsovia. ¿Qué harías?»" Foreground="{StaticResource MutedBrush}"/>
      </Button>
      <TextBlock Text="Pulsa el ejemplo para editarlo." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
     </StackPanel>
     </ScrollViewer>
    </Grid>
    <TextBox Grid.Row="1" x:Name="PromptBox" MinHeight="78" MaxHeight="140" Margin="0,8,0,10" AcceptsReturn="True" TextWrapping="Wrap"
     MaxLength="8000" VerticalScrollBarVisibility="Auto" PreviewKeyDown="Prompt_PreviewKeyDown"
     AutomationProperties.Name="Tu pregunta" AutomationProperties.AutomationId="PromptBox"/>
    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="Enter envía · Shift+Enter, nueva línea" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
      <Button x:Name="ClearButton" Content="Nueva conversación" Click="Clear_Click" HorizontalAlignment="Left" Padding="0,5" Margin="0,3,0,0" BorderBrush="Transparent" Background="Transparent" FontSize="12" AutomationProperties.AutomationId="ClearButton"/>
     </StackPanel>
     <Button Grid.Column="1" x:Name="CancelButton" Content="Cancelar" Click="Cancel_Click" Visibility="Collapsed" Margin="0,0,6,0" VerticalAlignment="Center" AutomationProperties.AutomationId="CancelButton"/>
     <Button Grid.Column="2" x:Name="SendButton" Content="Enviar" Click="Send_Click" Background="{StaticResource AccentBrush}" Foreground="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource AccentBrush}" VerticalAlignment="Center" AutomationProperties.AutomationId="SendButton"/>
    </Grid>
   </Grid>
    </TabItem>
    <TabItem x:Name="BrowserTab" Header="ChatGPT web" AutomationProperties.AutomationId="BrowserTab">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <WrapPanel Margin="0,0,0,8">
       <Button Content="Inicio" Click="BrowserHome_Click" Margin="0,0,6,4" AutomationProperties.AutomationId="BrowserHomeButton"/>
       <Button x:Name="BrowserReloadButton" Content="Recargar" Click="BrowserReload_Click" Margin="0,0,6,4" AutomationProperties.AutomationId="BrowserReloadButton"/>
       <Button Content="Abrir fuera" Click="BrowserExternal_Click" Margin="0,0,0,4" ToolTip="Abrir en tu navegador habitual; tiene una sesión independiente" AutomationProperties.AutomationId="BrowserExternalButton"/>
      </WrapPanel>
      <TextBox Grid.Row="1" x:Name="BrowserAddressBox" IsReadOnly="True" Text="https://chatgpt.com/" FontSize="12" Padding="8,5" Margin="0,0,0,10"
       AutomationProperties.Name="Dirección de la página" AutomationProperties.AutomationId="BrowserAddressBox"/>
      <Grid Grid.Row="2">
       <Grid x:Name="BrowserHost"/>
       <StackPanel x:Name="BrowserNotice" VerticalAlignment="Center" Margin="16">
        <TextBlock x:Name="BrowserNoticeText" Text="Preparando el navegador…" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>
        <Button x:Name="InstallBrowserButton" Content="Descargar WebView2" Click="InstallBrowser_Click" HorizontalAlignment="Left" Visibility="Collapsed" AutomationProperties.AutomationId="InstallBrowserButton"/>
       </StackPanel>
      </Grid>
     </Grid>
    </TabItem>
   </TabControl>
   <ScrollViewer Grid.Row="2" x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock Text="Conecta tu asistente" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="API Responses de OpenAI por defecto. También puedes usar endpoints compatibles con Chat Completions." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>
     <Label Content="Endpoint completo" Target="{Binding ElementName=EndpointBox}" Foreground="{StaticResource InkBrush}" Padding="0,0,0,6"/>
     <TextBox x:Name="EndpointBox" AutomationProperties.AutomationId="EndpointBox" Margin="0,0,0,12"/>
     <Label Content="Modelo" Target="{Binding ElementName=ModelBox}" Foreground="{StaticResource InkBrush}" Padding="0,0,0,6"/>
     <TextBox x:Name="ModelBox" AutomationProperties.AutomationId="ModelBox" Margin="0,0,0,12"/>
     <Label Content="Clave API" Target="{Binding ElementName=ApiKeyBox}" Foreground="{StaticResource InkBrush}" Padding="0,0,0,6"/>
     <PasswordBox x:Name="ApiKeyBox" AutomationProperties.AutomationId="ApiKeyBox" Margin="0,0,0,8"/>
     <TextBlock Text="Se guarda cifrada para tu usuario de Windows. Vacío usa OVERLAY_API_KEY o OPENAI_API_KEY; un servidor local puede funcionar sin clave." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>
     <WrapPanel>
      <Button Content="Guardar" Click="SaveSettings_Click" Background="{StaticResource AccentBrush}" Foreground="{StaticResource BackgroundBrush}" Margin="0,0,8,8" AutomationProperties.AutomationId="SaveSettingsButton"/>
      <Button Content="Volver al chat" Click="Back_Click" Margin="0,0,0,8" AutomationProperties.AutomationId="BackButton"/>
     </WrapPanel>
     <TextBlock Text="La conversación permanece solo en memoria. Cambiar de proveedor o modelo inicia una nueva conversación." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,16"/>
     <Button Content="Salir de la aplicación" Click="Exit_Click" HorizontalAlignment="Left" AutomationProperties.AutomationId="ExitButton"/>
    </StackPanel>
   </ScrollViewer>
   <TextBlock Grid.Row="3" x:Name="StatusText" Text="Listo · Esc vuelve al juego" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,12,0,0"
    AutomationProperties.AutomationId="StatusText" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Grid.Row="3" x:Name="BrowserStatusText" Text="ChatGPT web · Esc vuelve al juego" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,12,0,0" Visibility="Collapsed"
    AutomationProperties.AutomationId="BrowserStatusText" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
 </Border>
</Window>
