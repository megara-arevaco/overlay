<Window x:Class="GameChatOverlay.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="{DynamicResource AppTitle}" Icon="Assets/agripa.ico" Width="700" Height="760" MinWidth="400" MinHeight="520"
 AllowsTransparency="True" WindowStyle="None" ResizeMode="CanResize" Topmost="True" ShowInTaskbar="False"
 Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource InkBrush}"
 FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" PreviewKeyDown="Window_PreviewKeyDown">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0"/>
 </shell:WindowChrome.WindowChrome>
 <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18,14,18,12">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel MouseLeftButtonDown="Title_MouseLeftButtonDown" Background="Transparent" Margin="0,0,8,0">
     <StackPanel Orientation="Horizontal">
      <Image Source="Assets/agripa.ico" Width="24" Height="24" Margin="0,0,8,0"/>
      <TextBlock Text="Agripa" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </StackPanel>
     <TextBlock x:Name="HotkeyHint" Text="{DynamicResource HotkeyHint}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
    </StackPanel>
    <Button Grid.Column="1" x:Name="SettingsButton" ToolTip="{DynamicResource Settings}" AutomationProperties.Name="{DynamicResource Settings}" Click="Settings_Click" Margin="0,0,6,0" VerticalAlignment="Top" AutomationProperties.AutomationId="SettingsButton"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="16"/></Button>
    <Button Grid.Column="2" Content="—" Click="Hide_Click" VerticalAlignment="Top" Padding="10,8" ToolTip="{DynamicResource HideEsc}" AutomationProperties.Name="{DynamicResource HideOverlay}" AutomationProperties.AutomationId="HideButton"/>
   </Grid>
   <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,12"/>
   <Grid Grid.Row="2" x:Name="BrowserPanel">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <WrapPanel Margin="0,0,0,8">
       <Button x:Name="CaptureButton" ToolTip="{DynamicResource CaptureShortcut}" AutomationProperties.Name="{DynamicResource CaptureName}" Click="Capture_Click" Margin="0,0,6,4" AutomationProperties.AutomationId="CaptureButton"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE722;" FontSize="16"/></Button>
       <Button x:Name="CropCaptureButton" ToolTip="{DynamicResource CropCapture}" AutomationProperties.Name="{DynamicResource CropName}" Click="CropCapture_Click" Margin="0,0,6,4" AutomationProperties.AutomationId="CropCaptureButton"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A8;" FontSize="16"/></Button>
       <Button ToolTip="{DynamicResource Home}" AutomationProperties.Name="{DynamicResource Home}" Click="BrowserHome_Click" Margin="0,0,6,4" AutomationProperties.AutomationId="BrowserHomeButton"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="16"/></Button>
       <Button x:Name="BrowserReloadButton" ToolTip="{DynamicResource Reload}" AutomationProperties.Name="{DynamicResource Reload}" Click="BrowserReload_Click" Margin="0,0,6,4" AutomationProperties.AutomationId="BrowserReloadButton"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="16"/></Button>
       <Button ToolTip="{DynamicResource OpenExternal}" AutomationProperties.Name="{DynamicResource OpenExternal}" Click="BrowserExternal_Click" Margin="0,0,0,4" AutomationProperties.AutomationId="BrowserExternalButton"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A7;" FontSize="16"/></Button>
      </WrapPanel>
      <TextBox Grid.Row="1" x:Name="BrowserAddressBox" IsReadOnly="True" Text="https://chatgpt.com/" FontSize="12" Padding="8,5" Margin="0,0,0,10"
       AutomationProperties.Name="{DynamicResource PageAddress}" AutomationProperties.AutomationId="BrowserAddressBox"/>
      <Grid Grid.Row="2">
       <Grid x:Name="BrowserHost"/>
       <StackPanel x:Name="BrowserNotice" VerticalAlignment="Center" Margin="16">
        <TextBlock x:Name="BrowserNoticeText" Text="{DynamicResource PreparingBrowser}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>
        <Button x:Name="InstallBrowserButton" Content="{DynamicResource DownloadWebView}" Click="InstallBrowser_Click" HorizontalAlignment="Left" Visibility="Collapsed" AutomationProperties.AutomationId="InstallBrowserButton"/>
       </StackPanel>
      </Grid>
     </Grid>

   <ScrollViewer Grid.Row="2" x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock Text="{DynamicResource Appearance}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="{DynamicResource AppearanceHelp}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>
     <Label Content="{DynamicResource Opacity}" Target="{Binding ElementName=OpacitySlider}" Foreground="{StaticResource InkBrush}" Padding="0,0,0,6"/>
     <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" Value="85" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10"
      ValueChanged="OpacitySlider_ValueChanged" AutomationProperties.Name="{DynamicResource OverlayOpacity}" AutomationProperties.AutomationId="OpacitySlider"/>
     <TextBlock x:Name="OpacityValueText" Text="85 %" Margin="0,8,0,18" AutomationProperties.AutomationId="OpacityValueText"/>
     <StackPanel Orientation="Horizontal" Margin="0,10,0,14">
      <TextBlock Text="{DynamicResource LanguageLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <ComboBox x:Name="LanguageSelector" Width="140" SelectedValuePath="Tag" SelectionChanged="LanguageSelector_SelectionChanged" AutomationProperties.Name="{DynamicResource LanguageLabel}">
       <ComboBoxItem Content="Español" Tag="es"/>
       <ComboBoxItem Content="English" Tag="en"/>
      </ComboBox>
     </StackPanel>
     <WrapPanel>
      <Button Content="{DynamicResource Save}" Click="SaveSettings_Click" Background="{StaticResource AccentBrush}" Foreground="{StaticResource BackgroundBrush}" Margin="0,0,8,8" AutomationProperties.AutomationId="SaveSettingsButton"/>
      <Button Content="{DynamicResource BackToChat}" Click="Back_Click" Margin="0,0,0,8" AutomationProperties.AutomationId="BackButton"/>
     </WrapPanel>
     <TextBlock Text="{DynamicResource OpacityHelp}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,16"/>
     <Button Content="{DynamicResource ExitApp}" Click="Exit_Click" HorizontalAlignment="Left" AutomationProperties.AutomationId="ExitButton"/>
    </StackPanel>
   </ScrollViewer>
   <TextBlock Grid.Row="3" x:Name="StatusText" Visibility="Collapsed" Text="{DynamicResource ReadyEsc}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,12,0,0"
    AutomationProperties.AutomationId="StatusText" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Grid.Row="3" x:Name="BrowserStatusText" Text="{DynamicResource ChatEsc}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,12,0,0"
    AutomationProperties.AutomationId="BrowserStatusText" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
 </Border>
</Window>
