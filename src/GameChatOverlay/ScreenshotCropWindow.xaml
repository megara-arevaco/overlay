<Window x:Class="GameChatOverlay.ScreenshotCropWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource CropCapture}" WindowStyle="None" ResizeMode="NoResize"
 Topmost="True" ShowInTaskbar="False" Background="Black" Cursor="Cross"
 PreviewKeyDown="Crop_PreviewKeyDown" AutomationProperties.AutomationId="ScreenshotCropWindow">
 <Grid x:Name="CaptureSurface" Background="Transparent" SizeChanged="Surface_SizeChanged"
  MouseLeftButtonDown="Selection_Start" MouseMove="Selection_Move" MouseLeftButtonUp="Selection_End">
  <Image x:Name="ScreenshotImage" Stretch="Fill"/>
  <Path x:Name="Shade" Fill="#88000000" IsHitTestVisible="False"/>
  <Canvas IsHitTestVisible="False">
   <Rectangle x:Name="SelectionOutline" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Visibility="Collapsed"/>
  </Canvas>
  <Border Background="#E6191D1C" CornerRadius="6" Padding="16,10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12">
   <TextBlock x:Name="InstructionsText" Text="{DynamicResource CropInstructions}" Foreground="{StaticResource InkBrush}" FontSize="14"/>
  </Border>
 </Grid>
</Window>
